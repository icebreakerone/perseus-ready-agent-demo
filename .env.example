# Where this app is reachable from the browser. The OAuth redirect URI is
# derived from it; IB1 does not require redirect URIs to be pre-registered.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Trust Framework environment
DIRECTORY_URL=https://directory.core.sandbox.trust.ib1.org
REGISTRY_URL=https://registry.core.sandbox.trust.ib1.org

# Our organisation and the application registered for this demo
CAP_MEMBER_ID=4tnapijm
CAP_APPLICATION_ID=ciro1gll

# Counterparties
EDP_MEMBER_ID=7a1qv915
# The FSP the SME is sharing their report with. May be overridden per visit
# with ?fsp=<Directory member URL> on the landing page.
FSP_MEMBER_URL=https://directory.core.sandbox.trust.ib1.org/m/3vbfb8c1

# The Directory lists the sandbox EDP's endpointURL as
# https://perseus-demo-energy.ib1.org/consumption/datasources/ which 404s.
# When set, this base is used instead and the deviation is shown in the UI.
EDP_RESOURCE_BASE_OVERRIDE=https://mtls.perseus-demo-energy.ib1.org

# Certificates, as written by scripts/setup-certs.sh
CLIENT_CERT_PATH=certs/ciro1gll-client-cert.pem
CLIENT_KEY_PATH=certs/ciro1gll-client-key.pem
CLIENT_CA_DIR=certs/directory-client-certificates
SIGNING_CERT_PATH=certs/ciro1gll-signing-cert.pem
SIGNING_KEY_PATH=certs/ciro1gll-signing-key.pem
SIGNING_CA_DIR=certs/directory-signing-certificates

# The demo SME's account with us (the CAP). Not an IB1 credential.
DEMO_SME_USERNAME=demo
DEMO_SME_PASSWORD=perseus
DEMO_SME_NAME=Acme Bakery Ltd
DEMO_SME_ID=SME-000123
